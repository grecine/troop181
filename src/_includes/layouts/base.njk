<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{ title | default(site.name) }}</title>
    <link rel="stylesheet" href="/assets/styles.css">
    <style>
      :root {
        --max-width: {{ site.theme.maxWidth }};
        --font-family: {{ site.theme.fontFamily }};
        --page-background: {{ site.theme.pageBackground }};
        --header-background: {{ site.theme.headerBackground }};
        --accent: {{ site.theme.accent }};
        --accent-hover: {{ site.theme.accentHover }};
        --navigation-text: {{ site.theme.navigationText }};
        --text: {{ site.theme.text }};
        --muted-text: {{ site.theme.mutedText }};
        --border: {{ site.theme.border }};
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <h1 class="site-title"><a href="/">{{ site.name }}</a></h1>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="/">Welcome</a>
          {% for page in collections.sitePages %}
            {% if page.url != "/" %}
              <a href="{{ page.url }}">{{ page.data.title }}</a>
            {% endif %}
          {% endfor %}
        </nav>
      </div>
    </header>

    <main class="wrap">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>{{ site.name }} — Edit pages via the GitHub web UI.</p>
      </div>
    </footer>
  </body>
</html>
